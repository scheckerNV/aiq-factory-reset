# Environment variables for DGX Factory Reset Docker deployment
# Copy this file to .env and update with your actual values

# Build Arguments
AIQ_VERSION=1.0.0
PYTHON_VERSION=3.12
UV_VERSION=0.6.17

# API Keys (required for LLM access)
NVIDIA_API_KEY=your_nvidia_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Configuration options
AIQ_CONFIG_FILE=/workspace/examples/factory_reset/src/aiq_dgx_factory_reset/configs/factory_reset_orchestrator.yml

# Optional: Override default ports if needed
# FACTORY_RESET_PORT=8000
# REDIS_PORT=6379
# REDISINSIGHT_PORT=5540
# PHOENIX_UI_PORT=6006
# PHOENIX_GRPC_PORT=4317

# Optional: Logging configuration
# AIQ_LOG_LEVEL=INFO
